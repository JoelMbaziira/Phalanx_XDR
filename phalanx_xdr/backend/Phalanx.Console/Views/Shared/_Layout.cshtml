@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    string Active(params string[] paths) =>
        paths.Any(p => path == p.ToLowerInvariant() || path.StartsWith(p.ToLowerInvariant() + "/"))
            ? "is-active" : "";

    var autoRefresh = ViewData["AutoRefresh"] as string;   // seconds; views opt in
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Phalanx XDR</title>
    <link rel="stylesheet" href="~/css/phalanx.css" asp-append-version="true" />
</head>
<body data-auto-refresh="@autoRefresh">
<div class="phx-app">

    <aside class="phx-sidebar">

        <div class="phx-brand">
            <div class="phx-brand-tile">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
                    <path d="M16 2 L28 9 L28 23 L16 30 L4 23 L4 9 Z"/>
                    <path d="M16 2 L16 30 M4 9 L28 23 M28 9 L4 23" stroke-opacity="0.5"/>
                    <circle cx="16" cy="16" r="2.5" fill="currentColor" stroke="none"/>
                </svg>
            </div>
            <div class="phx-brand-text">
                <div class="phx-brand-name">Phalanx</div>
                <div class="phx-brand-sub">Security Operations</div>
            </div>
        </div>

        <nav class="phx-nav">

            <div class="phx-nav-group">
                <div class="phx-nav-group-label">Operations</div>
                <a href="/" class="phx-nav-item @Active("/", "/Dashboard")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12L5 10M5 10L12 3L19 10M5 10V20A1 1 0 006 21H9M19 10L21 12M19 10V20A1 1 0 0118 21H15M9 21A1 1 0 0010 20V16A1 1 0 0111 15H13A1 1 0 0114 16V20A1 1 0 0015 21M9 21H15"/></svg>
                    Overview
                </a>
                <a href="/sensor-alerts" class="phx-nav-item @Active("/sensor-alerts")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 17H20L18.6 15.6A2 2 0 0118 14.2V11A6 6 0 0013.5 5.2V5A1.5 1.5 0 1010.5 5V5.2A6 6 0 006 11V14.2A2 2 0 015.4 15.6L4 17H9M15 17V18A3 3 0 119 18V17M15 17H9"/></svg>
                    Sensor Alerts
                </a>
                <a href="/response" class="phx-nav-item @Active("/response")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 10V3L4 14H11V21L20 10H13Z"/></svg>
                    Response
                </a>
            </div>

            <div class="phx-nav-group">
                <div class="phx-nav-group-label">Telemetry</div>
                <a href="/events" class="phx-nav-item @Active("/events")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6H20M4 10H20M4 14H20M4 18H20"/></svg>
                    Process Events
                </a>
                <a href="/network" class="phx-nav-item @Active("/network")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 11H5A2 2 0 017 13V14A2 2 0 009 16A2 2 0 0111 18V20.9M8 3.9V5.5A2.5 2.5 0 0010.5 8H11A2 2 0 0113 10A2 2 0 0015 12H17M21 12A9 9 0 11 3 12A9 9 0 0121 12Z"/></svg>
                    Network
                </a>
                <a href="/files" class="phx-nav-item @Active("/files")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12H15M9 16H15M17 21H7A2 2 0 015 19V5A2 2 0 017 3H12.6A1 1 0 0113.3 3.3L18.7 8.7A1 1 0 0119 9.4V19A2 2 0 0117 21Z"/></svg>
                    Files
                </a>
                <a href="/logins" class="phx-nav-item @Active("/logins")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 16L7 12M7 12L11 8M7 12H21M16 16V17A3 3 0 0113 20H6A3 3 0 013 17V7A3 3 0 016 4H13A3 3 0 0116 7V8"/></svg>
                    Logins
                </a>
                <a href="/memory" class="phx-nav-item @Active("/memory")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 3V4H4V8H5V20H19V8H20V4H15V3H9ZM9 8H15M9 12H15M9 16H13"/></svg>
                    Memory
                </a>
                <a href="/devices" class="phx-nav-item @Active("/devices")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20H16M12 16V20"/></svg>
                    Devices
                </a>
                <a href="/sensor-dns" class="phx-nav-item @Active("/sensor-dns")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12H21M12 3A14 14 0 0112 21M12 3A14 14 0 0012 21"/></svg>
                    Sensor DNS
                </a>
                <a href="/email" class="phx-nav-item @Active("/email")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8L10.9 13.3A2 2 0 0013.1 13.3L21 8M5 20H19A2 2 0 0021 18V6A2 2 0 0019 4H5A2 2 0 003 6V18A2 2 0 005 20Z"/></svg>
                    Email / Phishing
                </a>
            </div>

            <div class="phx-nav-group">
                <div class="phx-nav-group-label">Detection</div>
                <a href="/Rules" class="phx-nav-item @Active("/Rules")">
                    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7A2 2 0 005 7V19A2 2 0 007 21H17A2 2 0 0019 19V7A2 2 0 0017 5H15M9 5A2 2 0 0011 7H13A2 2 0 0015 5M9 5A2 2 0 0111 3H13A2 2 0 0115 5M12 12H15M9 12H9.01"/></svg>
                    Rules
                </a>
                <a href="/policies" class="phx-nav-item @Active("/policies")">
    <svg class="phx-nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M13 10V3L4 14H11V21L20 10H13Z"/>
    </svg>
    Policies
</a>
            </div>
        </nav>

        <div class="phx-sidebar-foot">
            <span class="phx-pulse"></span>
            <span>Live · ingest active</span>
        </div>
    </aside>

    <main class="phx-main">
        @RenderBody()
    </main>
</div>

<script src="~/js/phalanx.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
