@model IEnumerable<Phalanx.Shared.Data.FileEvent>
@{ ViewData["Title"] = "Phalanx XDR — File Events"; }

<style>
    body { background:#0d1117; color:#e6edf3; font-family:'Segoe UI', sans-serif; }
    .xdr-header { padding:20px 24px 12px; border-bottom:1px solid #21262d; display:flex; align-items:center; gap:16px; }
    .xdr-brand  { font-size:18px; font-weight:600; color:#58a6ff; }
    .xdr-nav a  { color:#8b949e; font-size:13px; text-decoration:none; margin-right:12px; }
    .xdr-nav a:hover { color:#e6edf3; }
    .xdr-nav a.active { color:#e6edf3; border-bottom:2px solid #58a6ff; padding-bottom:2px; }
    .xdr-sub    { font-size:12px; color:#8b949e; margin-left:auto; }
    .search-bar { padding:12px 24px; background:#161b22; border-bottom:1px solid #21262d; display:flex; gap:8px; }
    .search-bar input  { background:#0d1117; border:1px solid #30363d; color:#e6edf3; padding:6px 12px; border-radius:6px; font-size:13px; width:300px; outline:none; }
    .search-bar button { background:#238636; color:#fff; border:none; padding:6px 16px; border-radius:6px; font-size:13px; cursor:pointer; }
    .section { padding:16px 24px; }
    .section-title { font-size:13px; font-weight:600; color:#8b949e; text-transform:uppercase; letter-spacing:.05em; margin-bottom:12px; }
    table { width:100%; border-collapse:collapse; font-size:13px; }
    th { text-align:left; padding:8px 12px; font-size:11px; color:#8b949e; border-bottom:1px solid #21262d; font-weight:500; }
    td { padding:9px 12px; border-bottom:1px solid #161b22; vertical-align:top; }
    tr:hover td { background:#161b22; }
    .badge  { display:inline-block; padding:2px 8px; border-radius:10px; font-size:11px; font-weight:500; }
    .act-open   { background:#1c2c3d; color:#58a6ff; }
    .act-mod    { background:#3d2c1c; color:#e3b341; }
    .act-exec   { background:#3d1c1c; color:#f85149; }
    .mono { font-family:monospace; font-size:12px; color:#8b949e; }
    .path { font-family:monospace; font-size:12px; max-width:360px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
</style>

<div class="xdr-header">
    <span class="xdr-brand">⬡ Phalanx XDR</span>
    <span class="xdr-nav">
        <a href="/">Alerts</a><a href="/events">Process</a><a href="/network">Network</a>
        <a href="/files" class="active">Files</a><a href="/logins">Logins</a>
        <a href="/memory">Memory</a><a href="/Rules">Rules</a>
        <a href="/response" style="color:#e3b341;">⚡ Response</a>
    </span>
    <span class="xdr-sub">@Model.Count() events</span>
</div>

<div class="search-bar">
    <form method="get">
        <input name="q" value="@ViewBag.Query" placeholder="Search path, process, host…" />
        <button type="submit">Search</button>
    </form>
</div>

<div class="section">
    <div class="section-title">File events — latest @Model.Count()</div>
    <table>
        <thead>
            <tr><th>Time</th><th>Action</th><th>Path</th><th>Size</th><th>SHA-256</th><th>Process</th><th>Host</th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model)
        {
            var cls = e.Action switch {
                "file_open" => "act-open",
                "file_modified" => "act-mod",
                "file_create_exec" => "act-exec",
                _ => "act-open"
            };
            <tr>
                <td class="mono">@e.Timestamp.ToString("HH:mm:ss")<br><span style="color:#484f58">@e.Timestamp.ToString("MM-dd")</span></td>
                <td><span class="badge @cls">@e.Action?.Replace("file_","")?.Replace("_"," ")</span></td>
                <td><div class="path" title="@e.FilePath">@e.FilePath</div></td>
                <td class="mono">@(e.FileSize.HasValue ? $"{e.FileSize:N0} B" : "—")</td>
                <td class="mono">@(e.FileHashSha256?.Length > 12 ? e.FileHashSha256[..12] + "…" : "—")</td>
                <td>@e.ProcessName <span class="mono">(pid @e.ProcessPid)</span></td>
                <td class="mono">@e.Hostname</td>
            </tr>
        }
        </tbody>
    </table>
</div>
